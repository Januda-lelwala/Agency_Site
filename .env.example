# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
#
# Every channel below is OPTIONAL and independent: configure the ones you want.
# The demo-request form works as long as at least one is set up.

# --- Chat bot backend (powers the live site assistant) ------------------
# The hosted bot brain. `/api/chat` proxies visitor messages to it server-side
# so the backend URL stays off the client and there is no mixed-content issue.
# CHAT_BOT_ID is the bot created on that backend (POST /api/bots).
CHAT_BACKEND_URL=http://167.86.114.134:3000
CHAT_BOT_ID=

# --- Supabase (stores every lead) ---------------------------------------
# Project settings → API. Use the SERVICE ROLE key (server-side only — it
# bypasses Row Level Security; never expose it in client code).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (email notification + auto-reply) ---------------------------
# https://resend.com → API Keys. FROM must be on a domain you've verified.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Bottify <hello@yourdomain.com>"
CONTACT_TO_EMAIL=you@yourdomain.com

# --- Discord (instant #leads ping) --------------------------------------
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=
